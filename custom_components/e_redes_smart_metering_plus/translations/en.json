{
  "config": {
    "step": {
      "user": {
        "title": "E-Redes Smart Metering Plus",
        "description": "Enter every CPE that is allowed to send data to this integration. Add one or more complete E-REDES CPE identifiers. Payloads for other CPEs are rejected.\n\nThe fixed local webhook URL is:\n\n**{webhook_url}**\n\nAfter setup, open Configure to see the active URL, including the Home Assistant Cloud URL when available.",
        "data": { "cpes": "Allowed CPE" }
      }
    },
    "error": {
      "invalid_cpe": "Enter at least one valid 20-character CPE beginning with PT",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": { "already_configured": "This integration is already configured" }
  },
  "options": {
    "step": {
      "init": {
        "title": "E-Redes webhook configuration",
        "description": "The active webhook URL is:\n\n**{webhook_url}**\n\nHome Assistant Cloud users can also find their external webhook URL under [Settings > Home Assistant Cloud > Webhooks](/config/cloud/webhooks).\n\nKeep all CPEs that should continue receiving updates in the list below, since payloads for CPEs not in this list are rejected.",
        "data": { "cpes": "Allowed CPE" }
      }
    }
  },
  "entity": {
    "select": { "contracted_power": { "name": "Contracted power" } },
    "binary_sensor": {
      "contracted_power_usage_warning": { "name": "Power usage warning" },
      "contracted_power_usage_critical": { "name": "Critical power usage" },
      "contracted_power_exceeded": { "name": "Power usage exceeded" }
    },
    "sensor": {
      "instantaneous_active_power_import": { "name": "Instantaneous active power import" },
      "max_active_power_import": { "name": "Maximum active power import" },
      "active_energy_import": { "name": "Active energy import" },
      "instantaneous_active_power_export": { "name": "Instantaneous active power export" },
      "max_active_power_export": { "name": "Maximum active power export" },
      "active_energy_export": { "name": "Active energy export" },
      "voltage_l1": { "name": "Voltage L1" },
      "voltage_l2": { "name": "Voltage L2" },
      "voltage_l3": { "name": "Voltage L3" },
      "instantaneous_active_power_import_l1": { "name": "Instantaneous active power import L1" },
      "instantaneous_active_power_import_l2": { "name": "Instantaneous active power import L2" },
      "instantaneous_active_power_import_l3": { "name": "Instantaneous active power import L3" },
      "instantaneous_active_power_export_l1": { "name": "Instantaneous active power export L1" },
      "instantaneous_active_power_export_l2": { "name": "Instantaneous active power export L2" },
      "instantaneous_active_power_export_l3": { "name": "Instantaneous active power export L3" },
      "instantaneous_active_current_import": { "name": "Instantaneous active current import" },
      "instantaneous_active_current_import_l1": { "name": "Instantaneous active current import L1" },
      "instantaneous_active_current_import_l2": { "name": "Instantaneous active current import L2" },
      "instantaneous_active_current_import_l3": { "name": "Instantaneous active current import L3" },
      "contracted_power_usage": { "name": "Power usage" },
      "contracted_power_usage_status": {
        "name": "Power usage status",
        "state": {
          "normal": "Normal",
          "warning": "Warning",
          "critical": "Critical",
          "exceeded": "Exceeded"
        }
      },
      "last_update": { "name": "Last update" },
      "update_interval": { "name": "Update interval" }
    }
  }
}
