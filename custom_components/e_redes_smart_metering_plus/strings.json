{
  "config": {
    "step": {
      "user": {
        "title": "E-Redes Smart Metering Plus",
        "description": "Enter every CPE that is allowed to send data to this integration. Add one or more complete E-REDES CPE identifiers. Payloads for other CPEs are rejected.\n\nThe fixed local webhook URL is:\n\n**{webhook_url}**\n\nAfter setup, open Configure to see the active URL, including the Home Assistant Cloud URL when available.",
        "data": { "cpes": "Allowed CPE" }
      }
    },
    "error": {
      "invalid_cpe": "Enter at least one valid 20-character CPE beginning with PT",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": { "already_configured": "This integration is already configured" }
  },
  "options": {
    "step": {
      "init": {
        "title": "E-Redes webhook configuration",
        "description": "The active webhook URL is:\n\n**{webhook_url}**\n\nHome Assistant Cloud users can also find their external webhook URL under [Settings > Home Assistant Cloud > Webhooks](/config/cloud/webhooks).\n\nKeep all CPEs that should continue receiving updates in the list below, since payloads for CPEs not in this list are rejected.",
        "data": { "cpes": "Allowed CPE" }
      }
    }
  },
  "entity": {
    "select": { "contracted_power": { "name": "Contracted power" } },
    "binary_sensor": {
      "contracted_power_usage_warning": { "name": "Estimated power usage warning" },
      "contracted_power_usage_critical": { "name": "Estimated critical power usage" },
      "contracted_power_exceeded": { "name": "Estimated power usage exceeded" }
    },
    "sensor": {
      "instantaneous_active_power_import": { "name": "Import power" },
      "max_active_power_import": { "name": "Peak import power" },
      "active_energy_import": { "name": "Imported energy" },
      "instantaneous_active_power_export": { "name": "Export power" },
      "max_active_power_export": { "name": "Peak export power" },
      "active_energy_export": { "name": "Exported energy" },
      "voltage_l1": { "name": "Voltage L1" },
      "voltage_l2": { "name": "Voltage L2" },
      "voltage_l3": { "name": "Voltage L3" },
      "instantaneous_active_power_import_l1": { "name": "Import power L1" },
      "instantaneous_active_power_import_l2": { "name": "Import power L2" },
      "instantaneous_active_power_import_l3": { "name": "Import power L3" },
      "instantaneous_active_power_export_l1": { "name": "Export power L1" },
      "instantaneous_active_power_export_l2": { "name": "Export power L2" },
      "instantaneous_active_power_export_l3": { "name": "Export power L3" },
      "instantaneous_active_current_import": { "name": "Estimated active import current" },
      "instantaneous_active_current_import_l1": { "name": "Estimated active import current L1" },
      "instantaneous_active_current_import_l2": { "name": "Estimated active import current L2" },
      "instantaneous_active_current_import_l3": { "name": "Estimated active import current L3" },
      "contracted_power_usage": { "name": "Estimated power usage" },
      "contracted_power_usage_status": {
        "name": "Estimated power usage status",
        "state": {
          "normal": "Normal",
          "warning": "Warning",
          "critical": "Critical",
          "exceeded": "Exceeded"
        }
      },
      "last_update": { "name": "Last update" },
      "update_interval": { "name": "Update interval" }
    }
  }
}
