#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_DIR"

if ! command -v uv >/dev/null 2>&1; then
    case "$(uname -s)" in
        Darwin)
            echo "Error: uv is required. Install it with: brew install uv"
            ;;
        *)
            echo "Error: uv is required. See https://docs.astral.sh/uv/getting-started/installation/"
            ;;
    esac
    exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
    echo "Error: Docker Desktop or Docker Engine with Compose is required."
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Error: Docker is installed but its engine is not running or is unavailable."
    exit 1
fi

echo "Locating Python 3.13..."
if ! uv python find 3.13 >/dev/null 2>&1; then
    if ! uv python install 3.13; then
        if ! uv python find 3.13 >/dev/null 2>&1; then
            echo "Error: uv could not install or locate Python 3.13."
            exit 1
        fi

        echo "Warning: uv reported an installation-link error, but Python 3.13 is available and will be used."
    fi
fi

if [ -x ".venv/bin/python" ] && \
    .venv/bin/python -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 13))'; then
    echo "Reusing the existing Python 3.13 environment..."
else
    echo "Creating the local Python environment..."
    uv venv --clear --python 3.13 .venv
fi

echo "Installing development dependencies..."
uv pip install --python .venv/bin/python -r requirements_dev.txt

echo "Installing the Git pre-commit hook..."
./scripts/install-hooks.sh

echo
echo "Local development environment is ready."
echo "Run 'make ha-up' to start Home Assistant."
echo "Open http://localhost:8123 after it starts."
