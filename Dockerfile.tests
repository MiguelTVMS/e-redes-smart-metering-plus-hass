FROM ghcr.io/home-assistant/home-assistant:2026.9.0

WORKDIR /workspace

COPY requirements_dev_base.txt requirements_dev.txt /tmp/

RUN python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements_dev.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/workspace

ENTRYPOINT ["pytest"]
CMD ["tests/", "-q", "--tb=short"]
